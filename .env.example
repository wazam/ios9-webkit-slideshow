# (Optional) Seconds between checks of pictures/_inbox/ for new photos to convert and move. Default: 30
INBOX_SCAN_SECONDS=30

# (Optional) Seconds between rescans of pictures/ that rewrite the photo list. Default: 60
PICTURES_SCAN_SECONDS=60

# (Optional) Minutes between browser reloads, which pick up added or removed photos. Default: 15
BROWSER_REFRESH_MINUTES=15

# (Optional) Seconds each photo stays on screen before crossfading to the next. Default: 10
SLIDESHOW_INTERVAL_SECONDS=10

# (Optional) true for a random order, reshuffled each full cycle; false for alphabetical path order. Default: true
SLIDESHOW_SHUFFLE=true

# (Optional) Time zone for the timestamps in the container's logs, as a tz database name such as America/New_York. Default: UTC
TZ=UTC
